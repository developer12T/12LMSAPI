<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log Viewer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .log-container {
            height: calc(100vh - 200px);
            overflow-y: auto;
            background-color: #1e1e1e;
            color: #fff;
            font-family: 'Consolas', monospace;
            padding: 1rem;
        }
        .log-entry {
            margin-bottom: 0.5rem;
            padding: 0.25rem;
            border-bottom: 1px solid #333;
        }
        .log-entry:hover {
            background-color: #2a2a2a;
        }
        .log-error { color: #ff6b6b; }
        .log-warn { color: #ffd93d; }
        .log-info { color: #4dabf7; }
        .log-debug { color: #69db7c; }
        .timestamp { color: #adb5bd; }
        .controls {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            padding: 1rem;
            border-bottom: 1px solid #dee2e6;
            z-index: 1000;
        }
        .filter-badge {
            cursor: pointer;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .filter-badge.active {
            opacity: 1;
        }
        .filter-badge:not(.active) {
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="controls">
            <div class="row mb-3">
                <div class="col">
                    <h2>Real-time Log Viewer</h2>
                </div>
                <div class="col-auto">
                    <button id="clearLogs" class="btn btn-outline-danger">
                        <i class="bi bi-trash"></i> Clear Logs
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <div class="btn-group" role="group">
                        <button class="btn btn-outline-danger filter-badge active" data-level="error">
                            <i class="bi bi-exclamation-circle"></i> Error
                        </button>
                        <button class="btn btn-outline-warning filter-badge active" data-level="warn">
                            <i class="bi bi-exclamation-triangle"></i> Warning
                        </button>
                        <button class="btn btn-outline-info filter-badge active" data-level="info">
                            <i class="bi bi-info-circle"></i> Info
                        </button>
                        <button class="btn btn-outline-success filter-badge active" data-level="debug">
                            <i class="bi bi-bug"></i> Debug
                        </button>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="autoScroll" checked>
                        <label class="form-check-label" for="autoScroll">Auto-scroll</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="log-container" id="logContainer"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const logContainer = document.getElementById('logContainer');
        const clearLogsBtn = document.getElementById('clearLogs');
        const autoScroll = document.getElementById('autoScroll');
        const filterBadges = document.querySelectorAll('.filter-badge');
        
        let logs = [];
        let activeFilters = new Set(['error', 'warn', 'info', 'debug']);

        function formatTimestamp(timestamp) {
            return new Date(timestamp).toLocaleTimeString();
        }

        function createLogEntry(log) {
            const div = document.createElement('div');
            div.className = `log-entry log-${log.level}`;
            div.innerHTML = `
                <span class="timestamp">[${formatTimestamp(log.timestamp)}]</span>
                <span class="level">[${log.level.toUpperCase()}]</span>
                <span class="message">${log.message}</span>
            `;
            return div;
        }

        function updateLogs() {
            logContainer.innerHTML = '';
            logs
                .filter(log => activeFilters.has(log.level))
                .forEach(log => {
                    logContainer.appendChild(createLogEntry(log));
                });
            
            if (autoScroll.checked) {
                logContainer.scrollTop = logContainer.scrollHeight;
            }
        }

        socket.on('log', (log) => {
            logs.push(log);
            if (logs.length > 1000) { // Keep last 1000 logs
                logs = logs.slice(-1000);
            }
            updateLogs();
        });

        clearLogsBtn.addEventListener('click', () => {
            logs = [];
            updateLogs();
        });

        filterBadges.forEach(badge => {
            badge.addEventListener('click', () => {
                const level = badge.dataset.level;
                badge.classList.toggle('active');
                
                if (badge.classList.contains('active')) {
                    activeFilters.add(level);
                } else {
                    activeFilters.delete(level);
                }
                
                updateLogs();
            });
        });
    </script>
</body>
</html> 